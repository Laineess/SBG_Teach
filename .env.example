# --- Región y modelo de Amazon Bedrock ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Nivel de esfuerzo del modelo: low | medium | high | xhigh | max
BEDROCK_EFFORT=medium

# --- Credenciales AWS (solo para desarrollo local) ---
# En Lambda NO se definen: se usa el IAM Role de la función.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Modo demo ---
# MOCK=1 devuelve una ruta de ejemplo sin llamar a Bedrock.
# Útil para la demo si no hay credenciales o el modelo no está habilitado.
MOCK=0

# Puerto del servidor local de desarrollo (emula API Gateway)
PORT=3000

# Orígenes permitidos por CORS (separados por coma, * para todos)
CORS_ORIGIN=*
